# ============================================================
# HEAVYWHEELS BACKEND — ENVIRONMENT TEMPLATE
# ============================================================
# Copy this file to ".env" and fill in real values:
#     cp .env.example .env       (macOS/Linux)
#     Copy-Item .env.example .env   (Windows PowerShell)
#
# This template is SAFE to commit. The real ".env" is gitignored
# and must NEVER be committed or shared (chat, screenshots, etc.).
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# ── MongoDB ──────────────────────────────────────────────────
# Local (Docker / installed mongod) — recommended for development:
MONGODB_URI=mongodb://localhost:27017/heavywheels
# Atlas SRV form (use in staging/production):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/heavywheels?retryWrites=true&w=majority
#
# IMPORTANT: "heavywheels" is the LIVE database. If you're pointing at the
# production Atlas cluster for local work, change the DB NAME here so your
# writes land somewhere harmless — the server prints a loud warning when a
# non-production process connects to the live database, and `npm run seed:dev`
# refuses to run against it outright.
MONGODB_DB_NAME=heavywheels_dev

# ── Destructive-work guards ──────────────────────────────────
# The hourly maintenance sweep permanently deletes expired listings + their
# Cloudinary images and emails real sellers. Both default to ON in production
# and OFF everywhere else; set to "true" only against a scratch database.
# Setting them to "false" in production acts as an emergency kill-switch.
# RUN_MAINTENANCE_SWEEPS=false
# ALLOW_OUTBOUND_EMAIL=false

# ── JWT ──────────────────────────────────────────────────────
# Generate each secret with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a DIFFERENT value for each. 64+ chars required in production.
JWT_ACCESS_SECRET=replace_with_generated_secret
JWT_REFRESH_SECRET=replace_with_a_different_generated_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_DOMAIN=localhost

# ── Cloudinary ───────────────────────────────────────────────
# From cloudinary.com → Dashboard. The API_SECRET is sensitive — keep it private.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=heavywheels/vehicles
MAX_IMAGE_SIZE_BYTES=8388608
MAX_IMAGES_PER_AD=15

# ── Translation (Groq — free, OpenAI-compatible) ─────────────
# Auto-translates listing title/description between Urdu and English at post
# time. Get a free key at console.groq.com. Leave blank to disable.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
TRANSLATION_ENABLED=true

# ── Email ────────────────────────────────────────────────────
# For Gmail, use an App Password (not your account password).
EMAIL_SERVICE=gmail
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=HeavyWheels <noreply@heavywheels.pk>

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# ── Admin Seed ───────────────────────────────────────────────
# Used by `npm run seed:admin`. Sample values are fine for development;
# replace with the real ones before production and re-run the seed.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_to_a_strong_password
ADMIN_NAME=HeavyWheels Admin
ADMIN_PHONE=03000000000

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_TO_FILE=false
