# ============================================================
# HEAVYWHEELS — DOCKER COMPOSE ENVIRONMENT
# ============================================================
# Copy this to .env in the project root before running:
#   cp .env.example .env
#
# These values are used by docker-compose.yml at BUILD and RUN time.
# ============================================================

# ── Frontend build args (baked into Next.js at build time) ───
# Set this to your VPS domain/IP in production, e.g.:
#   https://api.heavywheels.pk/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id
